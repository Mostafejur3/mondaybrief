# MondayBrief AI — environment template (placeholders only, never commit real secrets)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Bootstrap super-admin (used only on first seed)
ADMIN_EMAIL=admin@mondaybrief.ai
ADMIN_PASSWORD=change-me-in-production

# Encrypts integration secrets at rest (AES-256-GCM key material)
ENCRYPTION_KEY=

# Email provider (leave empty for labelled dev mode — no fake sends)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Payments (live billing requires products/prices + webhook; otherwise dev billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional external LLM (numbers always come from the deterministic engine)
OPENAI_API_KEY=

# Optional OAuth for connectors
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
